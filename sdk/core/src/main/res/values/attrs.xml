<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="OwnIdButtonTheme">
        <attr name="ownIdButtonStyle" format="reference" />
        <attr name="ownIdAuthButtonStyle" format="reference" />
    </declare-styleable>

    <attr name="ownIdBackgroundColor" format="color|reference" />
    <attr name="ownIdIconColor" format="color|reference" />
    <attr name="ownIdShowSpinner" format="boolean" />
    <attr name="ownIdSpinnerIndicatorColor" format="color|reference" />
    <attr name="ownIdSpinnerTrackColor" format="color|reference" />
    <attr name="ownIdLoginIdEditText" format="reference" />

    <declare-styleable name="OwnIdButton">
        <attr name="ownIdWidgetPosition" format="enum">
            <enum name="start" value="0" />
            <enum name="end" value="1" />
        </attr>
        <attr name="ownIdShowOr" format="boolean" />
        <attr name="ownIdOrTextAppearance" format="reference" />
        <attr name="ownIdBackgroundColor" />
        <attr name="ownIdBorderColor" format="color|reference" />
        <attr name="ownIdIconColor" />
        <attr name="ownIdShowSpinner" />
        <attr name="ownIdSpinnerIndicatorColor" />
        <attr name="ownIdSpinnerTrackColor" />
        <attr name="ownIdLoginIdEditText" />

        <attr name="ownIdTooltipTextAppearance" format="reference" />
        <attr name="ownIdTooltipBackgroundColor" format="color|reference" />
        <attr name="ownIdTooltipBorderColor" format="color|reference" />
        <attr name="ownIdTooltipPosition" format="enum">
            <enum name="none" value="0" />
            <enum name="top" value="1" />
            <enum name="bottom" value="2" />
            <enum name="start" value="3" />
            <enum name="end" value="4" />
        </attr>
    </declare-styleable>

    <declare-styleable name="OwnIdAuthButton">
        <attr name="ownIdTextColor" format="reference|color" />
        <attr name="ownIdTextAppearance" format="reference" />
        <attr name="ownIdBackgroundTint" format="color" />
        <attr name="ownIdRippleColor" format="color" />
        <attr name="ownIdSpinnerIndicatorColor" />
        <attr name="ownIdSpinnerTrackColor" />
        <attr name="ownIdLoginIdEditText" />
    </declare-styleable>
</resources>
